# API publicada no Render (configuração padrão do aplicativo)
EXPO_PUBLIC_API_URL=https://poupeazy-backend.onrender.com/api

# Para testar com o backend local no emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001/api

# Para testar com o backend local em um aparelho físico, use o IP da máquina:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3001/api

# Para testar com o backend local no navegador:
# EXPO_PUBLIC_API_URL=http://localhost:3001/api
